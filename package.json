{
  "name": "gold-paper-bot",
  "version": "1.0.0",
  "description": "Bot Telegram de paper trading de l'or avec plusieurs stratégies",
  "main": "bot.js",
  "scripts": {
    "start": "node bot.js",
    "once": "node once.js",
    "backtest": "node backtest.js",
    "check": "node --check bot.js && node --check once.js && node --check backtest.js && node --check research.js && node --check scalp.js && node --check nas-intraday.js && for f in src/*.js; do node --check $f || exit 1; done",
    "test": "node --test test/*.test.js",
    "research": "node research.js",
    "scalp": "node --max-old-space-size=3072 scalp.js",
    "nas-intraday": "node nas-intraday.js",
    "scalp2": "node --max-old-space-size=4096 scalp2.js",
    "pdf": "node -e \"console.log(JSON.stringify(require('./src/catalog').catalog(require('./src/config'))))\" > /tmp/catalog.json && python3 scripts/make-pdf.py /tmp/catalog.json",
    "ftmo": "node --max-old-space-size=4096 ftmo.js",
    "ftmo-mr": "node --max-old-space-size=4096 ftmo-mr.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "grammy": "^1.34.0"
  }
}
