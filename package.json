{
  "name": "gold-paper-bot",
  "version": "1.0.0",
  "description": "Bot Telegram de paper trading de l'or avec plusieurs stratégies",
  "main": "bot.js",
  "scripts": {
    "start": "node bot.js",
    "once": "node once.js",
    "backtest": "node backtest.js",
    "check": "node --check bot.js && node --check once.js && node --check backtest.js && node --check research.js && node --check scalp.js && node --check nas-intraday.js && for f in src/*.js; do node --check $f || exit 1; done",
    "test": "node --test test/*.test.js",
    "research": "node research.js",
    "scalp": "node --max-old-space-size=3072 scalp.js",
    "nas-intraday": "node nas-intraday.js",
    "scalp2": "node --max-old-space-size=4096 scalp2.js",
    "pdf": "(node scripts/guide-examples.js > /tmp/guide-examples.json && mv /tmp/guide-examples.json docs/guide-examples.json || true) && node -e \"console.log(JSON.stringify(require('./src/catalog').catalog(require('./src/config'))))\" > /tmp/catalog.json && python3 scripts/make-pdf.py /tmp/catalog.json",
    "ftmo": "node --max-old-space-size=4096 ftmo.js",
    "ftmo-mr": "node --max-old-space-size=4096 ftmo-mr.js",
    "ftmo-nas": "node ftmo-nas.js",
    "ftmo-gold": "node --max-old-space-size=4096 ftmo-gold.js",
    "nas-new": "node --max-old-space-size=4096 nas-new.js",
    "ftmo-night": "node ftmo-night.js",
    "gold-new": "node --max-old-space-size=4096 gold-new.js",
    "audit": "node --max-old-space-size=4096 audit.js",
    "nas-grid": "node nas-grid.js",
    "gold-grid": "node nas-grid.js gold",
    "gold-scalp-grid": "node --max-old-space-size=4096 gold-scalp-grid.js",
    "ftmo-nas-port": "node --max-old-space-size=4096 ftmo-nas-port.js",
    "nas-scalp-grid": "node --max-old-space-size=4096 gold-scalp-grid.js nas",
    "ftmo-combo": "node --max-old-space-size=4096 ftmo-combo.js",
    "ftmo-more": "node --max-old-space-size=6144 ftmo-more.js",
    "ftmo-grid": "node --max-old-space-size=6144 ftmo-grid.js",
    "ftmo-papers": "node --max-old-space-size=6144 ftmo-papers.js",
    "ftmo-sizing": "node --max-old-space-size=6144 ftmo-sizing.js",
    "ftmo-markets": "node --max-old-space-size=6144 ftmo-markets.js",
