    "ftmo-lucidlike": "node --max-old-space-size=7000 ftmo-lucidlike-research.js",
    "lucid-funded": "node --max-old-space-size=7000 lucid-funded-research.js",
    "portfolio": "node --max-old-space-size=4000 portfolio-research.js",
    "orderflow": "node --max-old-space-size=6000 orderflow-research.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.2.0",
    "grammy": "^1.34.0"
  }
