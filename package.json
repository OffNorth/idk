    "ftmo-formulas": "node --max-old-space-size=6144 ftmo-formulas.js",
    "ftmo-long": "node --max-old-space-size=8192 ftmo-long.js",
    "dukascopy": "python3 scripts/dukascopy.py",
    "histdata": "python3 scripts/histdata.py",
    "ftmo-real": "node --max-old-space-size=12288 ftmo-real.js",
    "ftmo-spx": "node --max-old-space-size=8192 ftmo-spx.js",
    "ftmo-intraday": "node --max-old-space-size=12288 ftmo-intraday.js",
    "lucid-compare": "node --max-old-space-size=12288 lucid-compare.js",
    "ftmo-protect": "node --max-old-space-size=12288 ftmo-protect.js",
    "ai-train": "node --max-old-space-size=12288 ai-train.js",
    "adapt-sim": "node --max-old-space-size=12288 adapt-sim.js",
    "ftmo-events": "node --max-old-space-size=12288 ftmo-events.js",
    "lucid-tune": "node --max-old-space-size=12288 lucid-tune.js",
    "mc-build": "node mc-build.js",
    "selftest": "node selftest.js",
    "sessions": "node --max-old-space-size=6144 session-research.js",
    "sessions2": "node --max-old-space-size=6144 session-research2.js",
    "lucid-research": "node --max-old-space-size=7000 lucid-research.js",
    "speed": "node --max-old-space-size=7000 speed-research.js",
    "lucid-research2": "node --max-old-space-size=7000 lucid-research2.js",
    "lucid-research3": "node --max-old-space-size=7000 lucid-research3.js",
    "traders": "node --max-old-space-size=7000 trader-research.js",
    "spx-research": "node --max-old-space-size=7000 spx-research.js",
    "markets-research": "node --max-old-space-size=7000 markets-research.js",
    "world-research": "node --max-old-space-size=7000 world-research.js",
    "lucid-research4": "node --max-old-space-size=7000 lucid-research4.js",
    "twoweeks": "node --max-old-space-size=7000 twoweeks-research.js",
    "lucid-markets": "node --max-old-space-size=7000 lucid-markets-research.js",
    "lucid-research5": "node --max-old-space-size=7000 lucid-research5.js",
    "ftmo-tsl": "node --max-old-space-size=7000 ftmo-tsl-research.js",
    "lucid-research6": "node --max-old-space-size=7000 lucid-research6.js",
