# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
# Canal ou groupe où publier les trades (ex: @mon_canal, -100123456789 ou -5438450670)
TELEGRAM_CHANNEL_ID=
# IDs Telegram autorisés à utiliser les commandes (séparés par des virgules, vide = tout le monde)
ALLOWED_TELEGRAM_USER_IDS=

# ---------- Paper trading de l'or (SIMULATION, aucun argent réel) ----------
GOLD_TRADING=1
# Capital de départ de chaque stratégie (USD). Les gains sont réinvestis.
GOLD_START_CAPITAL=1000
# Part du capital misée à chaque trade (%)
GOLD_POSITION_PCT=100
# Frais / spread simulés à l'entrée ET à la sortie (%)
GOLD_FEE_PCT=0.05
# Cours de l'or : future (GC=F, comme l'or d'un compte FTMO, défaut) ou paxg (ancien)
GOLD_FEED=future
# Frais des scalps 1 / 5 / 15 min (CFD, écart serré)
GOLD_SCALP_FEE_PCT=0.005
# Stratégies actives. Par défaut : celles retenues par le banc d'essai (npm run research) + la référence.
# Format : id ou id@unité (1h, 6h, 1d), ex. macd@1d. « all » = toutes à leur unité par défaut.
# ids : ema, breakout, meanrev, macd, supertrend, sma1060, pvt, fibo, tsmom, tsmom_ls, turtle, rsi2, pullback, keltner, asia, ichimoku, adx, squeeze, ribbon, insidebar, heikin, vote, dollar, hold
# Financement de nuit (%/an) : 0 pour le PAXG
GOLD_FINANCING_PCT=0
# Par défaut : celles qui tiennent sur 25 ans (npm run research -- goldlong). Autres possibles : vote, dollar,
# sma1060@1d, ema@1d, fibo@6h, vixcalm, yields, dxy, fear, double7, tom, ibs…
# GOLD_STRATEGIES=season,golden,trendmix,sma200,mom12_1,mom12,tsmom,high52,macd@1d,x_rsi2,m_bb@5m,m_ibs,m_rsi2x,m_wr@5m,m_keltner@5m,g_ibsh@5m,g_weekrev,g_low10,g_yieldfall,g_asia,g_oilfall,rsi2,ibs,double7,down3,vixspike,vixcalm,dualmom,season200,seasonplus,silver,macd_long,ema_long,x_orb5,x_lasthalf,m_down3,m_vwap,g_silverlead,hold

# ---------- Paper trading du Nasdaq 100 (indice ^NDX via Yahoo Finance, CFD NAS100 simulé) ----------
NAS_TRADING=1
# Retenues par le banc d'essai (npm run research -- nas100) + référence achat-conservation
# Autres disponibles : rsi2, double7, tom, cumrsi, dip5, high52, ibs, down3, vixspike, tuesday, pctb, ema_long…
# Intraday (5 min, formation TradingView NAS100) : sweep (actif, à l'essai), orb15 et vwappb (perdants au test)
# NAS_STRATEGIES=golden,mom12_1,trendmix,mom12,sma200,lowvol,rates,n_weekrev,n_low10,n_drop,n_dollarfall,n_rsspx,n_2down,n_goldfall,n_rsi4,tom,rsi2,ibs,double7,down3,vixspike,vixcalm,halloween,cumrsi,dip5,dualmom,macro,sox,macd_long,ema_long,x_orb5,x_lasthalf,m_down3,m_vwap,n_overnight,n_preholiday,n_opex,n_yieldfall,sweep,n_mom10,n_orb15,n_orb5s,hold
NAS_START_CAPITAL=1000
NAS_POSITION_PCT=100
# Spread / commission par côté (%)
NAS_FEE_PCT=0.01
# Financement de nuit d'un CFD (%/an), appliqué au prorata des jours en position
NAS_FINANCING_PCT=6

# ---------- Fréquence ----------
# Vérification des stops / signaux (minutes) — passe à 1 min automatiquement si une stratégie de scalp est active
CHECK_INTERVAL_MINUTES=3
# Bilan publié sur le canal toutes les X heures (0 = jamais)
SUMMARY_HOURS=4
# Graphique de l'évolution du portefeuille publié toutes les X heures (0 = jamais)
CHART_HOURS=24

DATA_DIR=./data

# ---------- Jeu du groupe : « Pronostic du jour » (boutons Hausse / Baisse) ----------
# 0 = désactivé
GAME=1
# Heure d'ouverture des tours, en UTC, du lundi au vendredi ; résultat au jour de bourse suivant, même heure
GAME_HOUR_UTC=13
# Durée des votes (heures)
GAME_VOTE_HOURS=3

# ---------- Compte FTMO simulé (commande /ftmo) ----------
# 0 = désactivé
FTMO=1
# Stratégies suivies par le compte, au format marché:id (ex. gold:x_rsi2,nas100:golden)
FTMO_STRATEGIES=gold:down3,gold:pctb,gold:ema_long,gold:g_yieldfall,eurusd:ibs,spx:down3,spx:n_goldfall,gold:g_orb30,gold:g_orb60,gold:g_mom8,gold:g_gap
# Risque des stratégies intraday du compte FTMO (les journalières gardent FTMO_RISK_PCT)
FTMO_INTRADAY_RISK_PCT=0.15
# Un message dans le groupe à chaque ouverture et clôture du compte FTMO (0 = seulement réussite / échec du challenge)
FTMO_TRADE_MESSAGES=1
# Jamais acheteur et vendeur du même marché en même temps sur le compte FTMO (le 2e signal, opposé, est ignoré)
FTMO_NO_HEDGE=1
FTMO_CAPITAL=100000
# Part du solde risquée par trade (en %, selon la distance au stop) et levier maximum
# FTMO_RISK_PCT=2
FTMO_LEVERAGE=30
# Plus de nouveau trade dans la journée après cette perte (%, 0 = jamais)
# FTMO_DAY_STOP_PCT=1
# Frais d'un CFD par côté (%)
FTMO_FEE_GOLD_PCT=0.005
FTMO_FEE_NAS_PCT=0.003

# ---------- Résumé du jour (scalp) ----------
# 1 = les trades des stratégies 1 / 5 / 15 min ne sont pas publiés un par un, mais dans un résumé par jour ; 0 = un message par trade
# 1 (par défaut) : le bot ne fait tourner que les stratégies des comptes FTMO (FTMO_STRATEGIES + FTMO_NAS_STRATEGIES)
# et ignore GOLD_STRATEGIES / NAS_STRATEGIES ; 0 = toutes les stratégies de ces deux listes
FTMO_ONLY=1
# Stratégies à l'essai en paper trading (marché:id), jamais suivies par le compte FTMO
TRIAL_STRATEGIES=
# EUR/USD (3e marché, journalier, à l'essai) ; 0 = coupé
EURUSD_TRADING=1
# Un message dans le groupe à chaque ouverture et clôture de trade (0 = seulement le résumé du jour)
# 1 (défaut) : le groupe ne voit que le compte FTMO (trades, réussite / échec, image du jour) ; 0 = tout publier
PUBLISH_FTMO_ONLY=1
TRADE_MESSAGES=1
SCALP_DIGEST=1
# Heure du résumé (UTC) — 21 h = après la clôture de New York
DIGEST_HOUR_UTC=21
# 1 = toutes les stratégies dans le résumé (journalières comprises), 0 = seulement le scalp
DIGEST_ALL=1

# 2e compte FTMO simulé, 100 % Nasdaq (stratégies à l'essai, non validées pour le challenge)
FTMO_NAS=1
# Compte FTMO unique or + Nasdaq (1, par défaut) : or au risque FTMO_RISK_PCT, Nasdaq au risque FTMO_COMBO_NAS_RISK_PCT
FTMO_COMBINED=1
# Levier dynamique du compte FTMO (src/sizing.js) : « objectif : dégressif doux » (défaut : risque ÷ 2 dès 2 positions
# ouvertes, et risque qui baisse à l'approche de l'objectif, jusqu'à × 0,4), « plusieurs positions → moins » ou « fixe »
# FTMO_SIZING=fixe
# Adaptation automatique (revue chaque dimanche) : l'IA ré-apprend sur les signaux live (1, défaut) ; 0 = tout figé
# AUTO_ADAPT=1
# Poids des stratégies appris en direct + candidates promues (0 par défaut : n'a pas aidé sur l'historique)
# ADAPT_STRATEGIES=0
# ADAPT_CANDIDATES=gold:g_low10,gold:g_weekrev,nas100:n_weekrev
# Interface en direct sur le site (catégorie « Bot ») : 1 (défaut) envoie l'état du bot ; 0 = coupé
# LIVE_PUSH=1
# SITE_URL=https://marches-eight.vercel.app
# Compte Lucid simulé (LucidFlex, micro-futures, /lucid) à côté du compte FTMO : 1 (défaut) ou 0
# LUCID=1
# LUCID_CAPITAL=50000
# LUCID_RISK_MUL=1.25
# Risque des stratégies intraday sur le compte Lucid (0 = pas d'intraday : elles font échouer la perte max serrée)
# LUCID_INTRADAY_RISK_PCT=0
# Règle de régularité de l'évaluation Lucid : meilleur jour ≤ 40 % du gain (50 = option payante)
# LUCID_CONSISTENCY_PCT=40
# Retraits simulés Lucid en compte financé : jour gagnant ≥ 150 $ (5 jours par cycle)
# LUCID_PAYOUT_MIN_DAY=150
# Délai entre le signal et l'exécution sur les comptes FTMO / Lucid (secondes, 0 = prix du signal)
# FILL_DELAY_SEC=30
# IA validatrice des trades du compte FTMO : block (défaut, refuse les signaux sous le seuil), observe (avis seulement), off
# FTMO_AI=observe
# FTMO_AI_MIN=0.40
# Formule du challenge : 1step (défaut : +10 %, perte du jour 3 %, perte max suiveuse), 2step ou swing.
# Les risques par défaut en dépendent (1 étape : or 0,35 %, Nasdaq 0,5 %, stop du jour 1 %).
FTMO_PROGRAM=1step
# FTMO_COMBO_NAS_RISK_PCT=2
# FTMO_EUR_RISK_PCT=2
FTMO_NAS_STRATEGIES=nas100:rsi2,nas100:ibs,nas100:down3,nas100:dip5,nas100:n_low10,nas100:n_drop,nas100:n_2down,nas100:n_dollarfall,nas100:rates,nas100:g_yieldfall,nas100:n_noise,nas100:n_orb5s,nas100:n_mom10,nas100:n_orb15
FTMO_NAS_RISK_PCT=3
