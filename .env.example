# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
# Channel or group where trades are posted (e.g. @my_channel, -100123456789 or -5438450670)
TELEGRAM_CHANNEL_ID=
# Telegram user IDs allowed to use admin commands (comma-separated, empty = everyone)
ALLOWED_TELEGRAM_USER_IDS=

# ---------- Gold paper trading (SIMULATION, no real money) ----------
GOLD_TRADING=1
# Starting capital of each strategy (USD). Gains are reinvested.
GOLD_START_CAPITAL=1000
# Share of capital used per trade (%)
GOLD_POSITION_PCT=100
# Simulated fees / spread on entry AND exit (%)
GOLD_FEE_PCT=0.05
# Gold price: future (GC=F, like the gold of an FTMO account, default) or paxg (old)
GOLD_FEED=future
# Fees of the 1 / 5 / 15 min scalps (CFD, tight spread)
GOLD_SCALP_FEE_PCT=0.005
# Active strategies. Default: the ones kept by the test bench (npm run research) + the benchmark.
# Format: id or id@timeframe (1h, 6h, 1d), e.g. macd@1d. "all" = all of them at their default timeframe.
# ids: ema, breakout, meanrev, macd, supertrend, sma1060, pvt, fibo, tsmom, tsmom_ls, turtle, rsi2, pullback, keltner, asia, ichimoku, adx, squeeze, ribbon, insidebar, heikin, vote, dollar, hold
# Overnight financing (%/yr): 0 for PAXG
GOLD_FINANCING_PCT=0
# Default: the ones that hold over 25 years (npm run research -- goldlong). Other options: vote, dollar,
# sma1060@1d, ema@1d, fibo@6h, vixcalm, yields, dxy, fear, double7, tom, ibs…
# GOLD_STRATEGIES=season,golden,trendmix,sma200,mom12_1,mom12,tsmom,high52,macd@1d,x_rsi2,m_bb@5m,m_ibs,m_rsi2x,m_wr@5m,m_keltner@5m,g_ibsh@5m,g_weekrev,g_low10,g_yieldfall,g_asia,g_oilfall,rsi2,ibs,double7,down3,vixspike,vixcalm,dualmom,season200,seasonplus,silver,macd_long,ema_long,x_orb5,x_lasthalf,m_down3,m_vwap,g_silverlead,hold

# ---------- Nasdaq 100 paper trading (^NDX index from Yahoo Finance, simulated NAS100 CFD) ----------
NAS_TRADING=1
# Kept by the test bench (npm run research -- nas100) + buy-and-hold benchmark
# Others available: rsi2, double7, tom, cumrsi, dip5, high52, ibs, down3, vixspike, tuesday, pctb, ema_long…
# Intraday (5 min, TradingView NAS100 course): sweep (active, on trial), orb15 and vwappb (losing in tests)
# NAS_STRATEGIES=golden,mom12_1,trendmix,mom12,sma200,lowvol,rates,n_weekrev,n_low10,n_drop,n_dollarfall,n_rsspx,n_2down,n_goldfall,n_rsi4,tom,rsi2,ibs,double7,down3,vixspike,vixcalm,halloween,cumrsi,dip5,dualmom,macro,sox,macd_long,ema_long,x_orb5,x_lasthalf,m_down3,m_vwap,n_overnight,n_preholiday,n_opex,n_yieldfall,sweep,n_mom10,n_orb15,n_orb5s,hold
NAS_START_CAPITAL=1000
NAS_POSITION_PCT=100
# Spread / commission per side (%)
NAS_FEE_PCT=0.01
# Overnight CFD financing (%/yr), prorated by days in position
NAS_FINANCING_PCT=6

# ---------- Frequency ----------
# Stop / signal check (minutes) — automatically 1 min when a scalp strategy is active
CHECK_INTERVAL_MINUTES=3
# Report posted to the channel every X hours (0 = never)
SUMMARY_HOURS=4
# Portfolio evolution chart posted every X hours (0 = never)
CHART_HOURS=24

DATA_DIR=./data

# ---------- Group game: "Daily prediction" (Up / Down buttons) ----------
# 0 = off
GAME=1
# Round opening hour, in UTC, Monday to Friday; result on the next trading day, same time
GAME_HOUR_UTC=13
# Voting window (hours)
GAME_VOTE_HOURS=3

# ---------- Simulated FTMO account (/ftmo command) ----------
# 0 = off
FTMO=1
# Strategies followed by the account, as market:id (e.g. gold:x_rsi2,nas100:golden)
FTMO_STRATEGIES=gold:down3,gold:pctb,gold:ema_long,gold:g_yieldfall,eurusd:ibs,spx:down3,spx:n_goldfall,gold:g_orb30,gold:g_orb60,gold:g_mom8,gold:g_gap
# Risk of the FTMO account's intraday strategies (daily ones keep FTMO_RISK_PCT)
FTMO_INTRADAY_RISK_PCT=0.15
# A message in the group on every FTMO account open and close (0 = only challenge pass / fail)
FTMO_TRADE_MESSAGES=1
# Never long and short the same market at the same time on the FTMO account (the 2nd, opposite signal is ignored)
FTMO_NO_HEDGE=1
FTMO_CAPITAL=100000
# Share of the balance risked per trade (%, from the distance to the stop) and max leverage
# FTMO_RISK_PCT=2
FTMO_LEVERAGE=30
# No new trade for the day after this loss (%, 0 = never)
# FTMO_DAY_STOP_PCT=1
# CFD fees per side (%)
FTMO_FEE_GOLD_PCT=0.005
FTMO_FEE_NAS_PCT=0.003

# ---------- Daily summary (scalp) ----------
# 1 (default): the bot only runs the FTMO accounts' strategies (FTMO_STRATEGIES + FTMO_NAS_STRATEGIES)
# and ignores GOLD_STRATEGIES / NAS_STRATEGIES; 0 = all strategies of both lists
FTMO_ONLY=1
# Strategies on trial in paper trading (market:id), never followed by the FTMO account
TRIAL_STRATEGIES=
# EUR/USD (3rd market, daily, on trial); 0 = off
EURUSD_TRADING=1
# 1 (default): the group only sees the FTMO account (trades, pass / fail, daily image); 0 = post everything
PUBLISH_FTMO_ONLY=1
# A message in the group on every trade open and close (0 = only the daily summary)
TRADE_MESSAGES=1
# 1 = 1 / 5 / 15 min strategy trades are not posted one by one but in a daily summary; 0 = one message per trade
SCALP_DIGEST=1
# Summary time (UTC) — 21:00 = after the New York close
DIGEST_HOUR_UTC=21
# 1 = every strategy in the summary (daily ones included), 0 = scalp only
DIGEST_ALL=1

# 2nd simulated FTMO account, 100% Nasdaq (strategies on trial, not validated for the challenge)
FTMO_NAS=1
# Single gold + Nasdaq FTMO account (1, default): gold at FTMO_RISK_PCT risk, Nasdaq at FTMO_COMBO_NAS_RISK_PCT
FTMO_COMBINED=1
# Dynamic FTMO sizing (src/sizing.js): "objectif : dégressif doux" (risk ÷ 2 from 2 open positions and risk decreasing
# near the target, down to × 0.4), "plusieurs positions → moins" (default) or "fixe"
# FTMO_SIZING=fixe
# FTMO account: × 0.5 if a position from the same group (US indices, metals, currencies) is open, or from 3 positions
# (instead of "2 open positions"); 0 for the old rule
# FTMO_GROUP_SIZING=1
# Funded FTMO account: risk × remaining cushion before the max loss (× 0.25 at the lowest); 0 to turn off
# (not on Lucid: with its max loss locked from the first payout it cuts payouts)
# FUNDED_CUSHION=1
# Two Lucid evaluations: intraday only (lucid.json) and daily only (lucid2.json); 0 = a single one
# LUCID_SPLIT=1
# Third Lucid evaluation, combined: intraday + daily on the same account (lucid3.json); 0 = only the two split ones
# LUCID_COMBINED=1
# No opposite positions from one Lucid account to another (Lucid forbids hedging between accounts); 0 = free.
# Cost (npm run lucid-ideas3, worst case): intraday evaluation pass 47% -> 31% (daily positions block opposite intraday trades)
# LUCID_NO_CROSS_HEDGE=1
# Crypto (BTC, ETH from Binance): 4h breakout + volume + real delta, buys only, FTMO account only, 0.25% risk; 0 = off
# CRYPTO=1
# FTMO_CRYPTO_RISK_PCT=0.25
# No Nasdaq daily strategies on the Lucid accounts (pass faster: at least one evaluation passed within 30 days 23% -> 37%,
# median 125 -> 42 days, $222 -> $190 per funded account; funded payouts $5,159 -> $4,406 over 12 months); 0 = keep them
# LUCID_NO_NAS_DAILY=1
# Gold intraday on the Lucid EVALUATIONS only (never funded). All 6 gold strategies at the Lucid intraday risk wreck the
# evaluation (pass 47% -> 2%); g_nypdl alone at 0.2% -> 65% pass but fewer fast passes (within 14 days 32% -> 11%). Empty = no gold
# LUCID_EVAL_GOLD=gold:g_nypdl
# LUCID_EVAL_GOLD_RISK_PCT=0.2
# Funded Lucid account: risk × LUCID_FUNDED_RISK_MUL until the first payout, then × LUCID_FUNDED_RISK_MUL_AFTER
# (3 then 1: payouts over 12 months $3,021 → $5,159 Nov 24–26, accounts lost 78% → 32%; sizes capped by the contract limit)
# LUCID_FUNDED_RISK_MUL=3
# LUCID_FUNDED_RISK_MUL_AFTER=1
# Funded Lucid account: daily strategies only (payouts $2,253 → $3,021 over 12 months, Nov 24–26); 0 = everything
# LUCID_FUNDED_DAILY_ONLY=1
# Day management (stop at +$750 or after 1 loss) on the daily Lucid evaluation too; 0 (default) = none there
# LUCID_DAILY_DAY_MGMT=0
# Automatic adaptation (review every Sunday): the AI retrains on live signals (1, default); 0 = everything frozen
# AUTO_ADAPT=1
# Strategy weights learned live + promoted candidates (0 by default: it did not help on history)
# ADAPT_STRATEGIES=0
# ADAPT_CANDIDATES=gold:g_low10,gold:g_weekrev,nas100:n_weekrev
# Live interface on the website ("Bot" tab): 1 (default) sends the bot's state; 0 = off
# LIVE_PUSH=1
# SITE_URL=https://marches-eight.vercel.app
# Simulated Lucid account (LucidFlex, micro futures, /lucid) next to the FTMO account: 1 (default) or 0
# LUCID=1
# LUCID_CAPITAL=50000
# LUCID_RISK_MUL=1.25
# Risk of intraday strategies on the Lucid account (0 = no intraday: they make the tight max loss fail)
# LUCID_INTRADAY_RISK_PCT=0.45
# Private copy of trade messages (buy, sell, pass, fail, payout) to admins: fallback (default: only if the group
# does not receive them), always, off
# TRADE_DM=fallback
# Intraday strategies taken by Lucid (gold intraday makes the tight max loss fail)
# LUCID_INTRADAY_STRATEGIES=nas100:n_noise,nas100:n_orb5s,nas100:n_mom10
# Lucid evaluation consistency rule: best day ≤ 40% of the gain (50 = paid option)
# LUCID_CONSISTENCY_PCT=40
# Simulated Lucid payouts on the funded account: winning day ≥ $150 (5 days per cycle)
# LUCID_PAYOUT_MIN_DAY=150
# Delay between the signal and execution on the FTMO / Lucid accounts (seconds, 0 = signal price)
# FILL_DELAY_SEC=30
# Real-time intraday candles (free OANDA demo account → Manage API Access → token); without a token: Yahoo
# OANDA_TOKEN=
# OANDA_ENV=practice
# INTRADAY_FEED=yahoo   (forces Yahoo even with a token)
# Gold and silver without OANDA: real-time candles of Binance's public XAUUSDT / XAGUSDT contracts (no account, no
# personal data; Yahoo if Binance is blocked). Check: npm run binance-check. 0 to turn off
# BINANCE_FEED=1
# Yahoo candles frozen while the price moves (US holidays): home-made 1-min candles (0 to turn off)
# STALE_FEED_FALLBACK=1
# Validator AI on the FTMO account: block (default, refuses signals below the threshold), observe (opinion only), off
# FTMO_AI=observe
# FTMO_AI_MIN=0.40
# AI on the Lucid account: observe (default, opinion without refusals; npm run ai-research), block, off
# LUCID_AI=observe
# Lucid evaluation passed → the funded account runs separately (1 at a time) and a new evaluation starts in parallel (0: as before)
# LUCID_PARALLEL=1
# Separate funded Lucid account started directly, without waiting for a passed evaluation (0: wait for a pass)
# LUCID_FUNDED_DIRECT=1
# Challenge program: 1step (default: +10%, daily loss 3%, trailing max loss), 2step or swing.
# Default risks depend on it (1 step: gold 0.35%, Nasdaq 0.5%, daily stop 1%).
FTMO_PROGRAM=1step
# FTMO_COMBO_NAS_RISK_PCT=2
# FTMO_EUR_RISK_PCT=2
FTMO_NAS_STRATEGIES=nas100:rsi2,nas100:ibs,nas100:down3,nas100:dip5,nas100:n_low10,nas100:n_drop,nas100:n_2down,nas100:n_dollarfall,nas100:rates,nas100:g_yieldfall,nas100:n_noise,nas100:n_orb5s,nas100:n_mom10,nas100:n_orb15
FTMO_NAS_RISK_PCT=3

# Silver (SI=F, SIL micro) and Dow Jones (^DJI, MYM micro): Lucid account markets (New York session intraday)
SILVER_TRADING=1
DOW_TRADING=1

# Lucid-only daily strategies (npm run lucid-research4)
LUCID_DAILY_STRATEGIES=spx:double7,spx:rsi2

# Lucid intraday risk × this number during the evaluation (2-week goal; 1 = off)
LUCID_EVAL_INTRADAY_MUL=3

# Lucid during the evaluation: day over at +X% of the target or after N losses (0 = off)
LUCID_DAY_PROFIT_CAP_PCT=25
LUCID_MAX_LOSSES_DAY=1

# Intraday stocks / ETFs on the FTMO account (TLT, GOOGL, PLTR, LLY, BA); 0 = off
STOCKS_TRADING=1

# FTMO account trailing stop: from +X R, stop Y R from the best price (0 = off)
FTMO_TRAIL_ACT_R=2
FTMO_TRAIL_DIST_R=1

# Funded FTMO account: partial exits at these levels (in R), an equal part at each, the rest on the trailing stop
FTMO_FUNDED_PARTIALS=1,2

# FTMO "like Lucid": intraday × X during the evaluation, day over at +X% of the target / after N losses, risk × X once funded
FTMO_EVAL_INTRADAY_MUL=2
FTMO_DAY_PROFIT_CAP_PCT=25
FTMO_MAX_LOSSES_DAY=1
FTMO_FUNDED_RISK_MUL=0.75
# ---------- Simulated personal portfolio (/myportfolio command) ----------
# 50% world, 10% gold, 40% daily bot strategies; computed once a day (0 to turn off)
PORTFOLIO=1
PORTFOLIO_CAPITAL=10000
