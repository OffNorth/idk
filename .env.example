# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
# Canal ou groupe où publier les trades (ex: @mon_canal, -100123456789 ou -5438450670)
TELEGRAM_CHANNEL_ID=
# IDs Telegram autorisés à utiliser les commandes (séparés par des virgules, vide = tout le monde)
ALLOWED_TELEGRAM_USER_IDS=

# ---------- Paper trading de l'or (SIMULATION, aucun argent réel) ----------
GOLD_TRADING=1
# Capital de départ de chaque stratégie (USD). Les gains sont réinvestis.
GOLD_START_CAPITAL=1000
# Part du capital misée à chaque trade (%)
GOLD_POSITION_PCT=100
# Frais / spread simulés à l'entrée ET à la sortie (%)
GOLD_FEE_PCT=0.05
# Stratégies actives. Par défaut : celles retenues par le banc d'essai (npm run research) + la référence.
# Format : id ou id@unité (1h, 6h, 1d), ex. macd@1d. « all » = toutes à leur unité par défaut.
# ids : ema, breakout, meanrev, macd, supertrend, sma1060, pvt, fibo, tsmom, tsmom_ls, turtle, rsi2, pullback, keltner, asia, ichimoku, adx, squeeze, ribbon, insidebar, heikin, vote, dollar, hold
# Financement de nuit (%/an) : 0 pour le PAXG
GOLD_FINANCING_PCT=0
# Par défaut : celles qui tiennent sur 25 ans (npm run research -- goldlong). Autres possibles : vote, dollar,
# sma1060@1d, ema@1d, fibo@6h, vixcalm, yields, dxy, fear, double7, tom, ibs…
# GOLD_STRATEGIES=season,seasonplus,golden,trendmix,sma200,mom12_1,mom12,tsmom,high52,macd@1d,x_rsi2,m_bb@5m,m_ibs,m_rsi2x,m_wr@5m,m_keltner@5m,g_weekrev,g_low10,g_yieldfall,g_silverlead,g_asia,hold

# ---------- Paper trading du Nasdaq 100 (indice ^NDX via Yahoo Finance, CFD NAS100 simulé) ----------
NAS_TRADING=1
# Retenues par le banc d'essai (npm run research -- nas100) + référence achat-conservation
# Autres disponibles : rsi2, double7, tom, cumrsi, dip5, high52, ibs, down3, vixspike, tuesday, pctb, ema_long…
# Intraday (5 min, formation TradingView NAS100) : sweep (actif, à l'essai), orb15 et vwappb (perdants au test)
# NAS_STRATEGIES=golden,mom12_1,macro,trendmix,mom12,sma200,lowvol,vixcalm,halloween,rates,tsmom,macd_long,sweep,m_down3,x_lasthalf,x_orb5,n_overnight,n_weekrev,n_low10,n_drop,n_dollarfall,n_rsspx,n_2down,n_goldfall,hold
NAS_START_CAPITAL=1000
NAS_POSITION_PCT=100
# Spread / commission par côté (%)
NAS_FEE_PCT=0.01
# Financement de nuit d'un CFD (%/an), appliqué au prorata des jours en position
NAS_FINANCING_PCT=6

# ---------- Fréquence ----------
# Vérification des stops / signaux (minutes) — passe à 1 min automatiquement si une stratégie de scalp est active
CHECK_INTERVAL_MINUTES=3
# Bilan publié sur le canal toutes les X heures (0 = jamais)
SUMMARY_HOURS=4
# Graphique de l'évolution du portefeuille publié toutes les X heures (0 = jamais)
CHART_HOURS=24

DATA_DIR=./data

# ---------- Jeu du groupe : « Pronostic du jour » (boutons Hausse / Baisse) ----------
# 0 = désactivé
GAME=1
# Heure d'ouverture des tours, en UTC, du lundi au vendredi ; résultat au jour de bourse suivant, même heure
GAME_HOUR_UTC=13
# Durée des votes (heures)
GAME_VOTE_HOURS=3

# ---------- Compte FTMO simulé (commande /ftmo) ----------
# 0 = désactivé
FTMO=1
# Stratégies suivies par le compte, au format marché:id (ex. gold:x_rsi2,nas100:golden)
FTMO_STRATEGIES=gold:x_rsi2,gold:m_bb@5m,gold:m_ibs,gold:m_rsi2x,gold:m_keltner@5m
FTMO_CAPITAL=100000
# Part du solde risquée par trade (en %, selon la distance au stop) et levier maximum
FTMO_RISK_PCT=0.5
FTMO_LEVERAGE=30
# Plus de nouveau trade dans la journée après cette perte (%, 0 = jamais)
FTMO_DAY_STOP_PCT=2
# Frais d'un CFD par côté (%)
FTMO_FEE_GOLD_PCT=0.005
FTMO_FEE_NAS_PCT=0.003

# ---------- Résumé du jour (scalp) ----------
# 1 = les trades des stratégies 1 / 5 / 15 min ne sont pas publiés un par un, mais dans un résumé par jour ; 0 = un message par trade
SCALP_DIGEST=1
# Heure du résumé (UTC) — 21 h = après la clôture de New York
DIGEST_HOUR_UTC=21
# 1 = toutes les stratégies dans le résumé (journalières comprises), 0 = seulement le scalp
DIGEST_ALL=1

# 2e compte FTMO simulé, 100 % Nasdaq (stratégies à l'essai, non validées pour le challenge)
FTMO_NAS=1
FTMO_NAS_STRATEGIES=nas100:m_down3,nas100:x_lasthalf,nas100:x_orb5,nas100:sweep,nas100:n_overnight,nas100:n_weekrev,nas100:n_low10,nas100:n_drop,nas100:n_dollarfall,nas100:n_rsspx,nas100:n_2down,nas100:n_goldfall
FTMO_NAS_RISK_PCT=0.5
