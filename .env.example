# ---------- Telegram (obligatoire pour bot.js, inutile pour `npm run scan`) ----------
TELEGRAM_BOT_TOKEN=
# Canal où publier les alertes automatiques (ex: @mon_canal ou -100123456789)
TELEGRAM_CHANNEL_ID=
# IDs Telegram autorisés à utiliser les commandes (séparés par des virgules, vide = tout le monde)
ALLOWED_TELEGRAM_USER_IDS=

# ---------- Fourchette de market cap (USD) ----------
MIN_MARKET_CAP=100000
MAX_MARKET_CAP=2000000

# ---------- Filtres de sécurité ----------
# Blockchain(s) DexScreener à scanner (solana, base, bsc, ethereum…)
CHAINS=solana
MIN_LIQUIDITY_USD=15000
MIN_VOLUME_24H_USD=30000
MIN_TXNS_24H=150
# Âge minimum / maximum de la paire (en heures)
MIN_PAIR_AGE_HOURS=1
MAX_PAIR_AGE_HOURS=720
# Rejette les tokens déjà trop pompés sur 24h (en %)
MAX_PRICE_CHANGE_24H=1500
# Vérification RugCheck (Solana uniquement) : 1 = activée
RUGCHECK_ENABLED=1
# Score RugCheck normalisé max accepté (0 = parfait, 100 = très risqué)
RUGCHECK_MAX_SCORE=50

# ---------- Alertes ----------
# Intervalle entre deux scans automatiques (minutes)
SCAN_INTERVAL_MINUTES=3
# Score minimum (0-100) pour publier une alerte sur le canal
MIN_ALERT_SCORE=65
# Nombre max d'alertes publiées par scan
MAX_ALERTS_PER_SCAN=3
# Afficher l'image du token au-dessus de l'alerte : 1 = oui
ALERT_WITH_IMAGE=1
# Publier un résumé du top 10 sur le canal toutes les X heures (0 = désactivé)
TOP_SUMMARY_HOURS=4
# Délai avant de pouvoir re-alerter le même token (heures)
ALERT_COOLDOWN_HOURS=12
# Combien de temps un token découvert reste suivi (heures)
WATCH_HOURS=48

# ---------- Paper trading de l'or (SIMULATION, aucun argent réel) ----------
GOLD_TRADING=1
# Montant simulé par trade et par stratégie (USD)
GOLD_SIZE_USD=1000
# Frais / spread simulés à l'entrée ET à la sortie (%)
GOLD_FEE_PCT=0.05
# Stratégies actives : all, ou une liste parmi ema,breakout,meanrev,macd,supertrend
GOLD_STRATEGIES=all

# ---------- Alertes meme coins ----------
# 1 = le bot publie aussi les alertes meme coins, 0 = or uniquement
SCANNER=1

# ---------- Paper trading des calls meme coins (désactivé par défaut) ----------
PAPER_TRADING=0
# Montant simulé par call (USD)
PAPER_SIZE_USD=100
# Take profit / stop loss (%)
PAPER_TP_PCT=100
PAPER_SL_PCT=40
# Trailing stop : activé après +X %, vend si le prix recule de Y % depuis son plus haut
PAPER_TRAIL_START_PCT=50
PAPER_TRAIL_PCT=30
# Vente forcée après N heures
PAPER_MAX_HOLD_HOURS=48
# Frais + slippage simulés à l'achat ET à la vente (%)
PAPER_FEE_PCT=2

# Recherches DexScreener supplémentaires pour découvrir des tokens
SEARCH_QUERIES=pump,meme,sol,dog,cat,ai
DATA_DIR=./data
